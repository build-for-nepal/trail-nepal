PORT=4000
BACKEND_URL=http://localhost:4000
NODE_ENV="development"
FRONTEND_URLS=http://localhost:3000,https://myapp.com

DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?schema=public"

BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=
AUTH_COOKIE_DOMAIN=
AUTH_CROSS_SITE_COOKIES=false

# Deep-link scheme of the Expo app, matching `expo.scheme` in mobile/app.json.
# Trusted as an OAuth redirect target so social sign-in can return to the app.
MOBILE_SCHEME=trailsnepal://

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
