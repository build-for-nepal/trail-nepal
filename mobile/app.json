{
  "expo": {
    "name": "Trails Nepal",
    "slug": "trails-nepal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "trailsnepal",
    "userInterfaceStyle": "light",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.trailsnepal"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
