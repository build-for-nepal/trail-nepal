{
  "expo": {
    "name": "Trails Nepal",
    "slug": "trails-nepal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "trailsnepal",
    "userInterfaceStyle": "light",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.trailsnepal"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trails Nepal uses your location to show where you are on trail maps and to find treks near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
