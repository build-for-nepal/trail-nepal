# Base URL of the Trails Nepal API, with no trailing slash.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so treat
# this as public and never put a secret behind that prefix.
#
# localhost resolves to the *device*, not your machine, so it only works in a
# web build or an iOS simulator sharing the host network. On a physical device
# or an Android emulator use your dev machine's LAN address instead, e.g.
# http://192.168.0.104:4000, and keep the phone on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:4000
